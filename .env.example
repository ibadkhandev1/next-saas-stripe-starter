# Absolute URL of the Express backend. Server-side only: the browser talks to
# the /api/auth proxy in this app, never to Express directly, so no CORS setup
# is needed and the session cookie stays first-party.
API_URL=http://localhost:3001

# Public URL of the site, used by metadata, sitemap, robots and social cards.
# Vercel previews fall back to their own URL when this is unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client id from the Google Cloud console (APIs & Services →
# Credentials → OAuth client ID, type "Web application").
#
# Public by design: Google's own flow puts it in the browser. The matching
# GOOGLE_CLIENT_SECRET belongs in the backend's .env and must never appear here.
# Leave this unset and the sign-in button is not rendered at all.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=